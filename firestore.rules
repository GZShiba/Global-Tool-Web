rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return request.auth.token.email_verified == true;
    }
    function isPrimaryEmail() {
      return request.auth.token.email == 'gzshiba99329@gmail.com';
    }
    function isSecondaryEmail() {
      return request.auth.token.email == 'hb9717777@gmail.com';
    }

    // The caller must hold an ACTIVE, UNEXPIRED PIN-verified session created
    // by the Worker (server-side) for their exact Firebase uid. The document
    // lives in admin_config/sessions/{uid}, is written only by the service
    // account, and is never client-writable.
    function hasActiveSession() {
      let session = get(/databases/$(database)/documents/admin_config/sessions/$(request.auth.uid));
      return session.data != null
        && session.data.active == true
        && session.data.expiresAt is timestamp
        && session.data.expiresAt >= request.time;
    }

    // The Secondary admin must additionally be enabled in the server-managed
    // accounts document. If the document is missing, the Secondary is denied
    // (fail closed). The Primary is never affected by this check.
    function isSecondaryEnabled() {
      let accounts = get(/databases/$(database)/documents/admin_config/accounts);
      return !isSecondaryEmail()
        || (accounts.data != null && accounts.data.secondaryEnabled == true);
    }

    // An administrator = authenticated + verified email + one of the two
    // allowlisted emails + active unexpired PIN session + (Secondary) enabled.
    function isAdmin() {
      return isSignedIn() && isVerified() && hasActiveSession()
        && (isPrimaryEmail() || isSecondaryEmail())
        && isSecondaryEnabled();
    }

    // Admin can read ALL CMS records (drafts, archived, disabled included).
    // Public can read ONLY published/enabled/active records.
    match /cms_tools/{docId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }
    match /cms_categories/{docId} {
      allow read: if isAdmin() || resource.data.enabled == true;
      allow write: if isAdmin();
    }
    match /cms_heroSlides/{docId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }
    match /cms_popular/{docId} {
      allow read: if true;      // public config
      allow write: if isAdmin();
    }
    match /cms_media/{docId} {
      allow read: if true;      // public image references
      allow write: if isAdmin();
    }

    // Contact messages: anyone may create a validated message — anonymous
    // visitors, authenticated non-admins, and the signed-in admin. ONLY a
    // PIN-verified admin may read, update (status), or delete them. Public
    // reads, updates, and deletes are denied outright, and create is
    // restricted to the exact expected fields with validated types/lengths
    // (no unexpected fields, no spoofed status, server timestamps only).
    // Authentication state must NOT gate create: an admin session is still
    // `request.auth != null`.
    match /contact_messages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subjectType','subject','message','status','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subjectType is string
        && request.resource.data.subjectType.size() >= 1
        && request.resource.data.subjectType.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['new','read','archived']);
      allow delete: if isAdmin();
    }

    // Contact subject configuration: read by everyone (public form shows only
    // enabled subjects); write restricted to a PIN-verified admin.
    match /contact_messages_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-managed admin configuration (accounts, security hash, sessions,
    // rate-limit counters): COMPLETELY inaccessible to browser clients. The
    // Worker service account writes these documents directly (bypassing rules
    // as a privileged server identity); rules only read them via get().
    match /admin_config/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
