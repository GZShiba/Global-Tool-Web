# OmniToolify runs entirely in the browser and requires no environment variables,
# API keys, or backend services. This file is intentionally empty of secrets.
#
# Deployment note: if you host the production build on a subdirectory
# (e.g. https://example.com/tools/), no extra configuration is needed —
# the app uses hash-based routing (#/tools, #/tool/<slug>), which works
# from any static file host.

# ---------------------------------------------------------------------------
# Firebase (optional) — enables cloud-persisted CMS reads/writes on the public
# site. Replace with your own project's public config values. NEVER commit
# real keys; these placeholders are safe. Missing config degrades gracefully
# to the local admin API / static catalog. No server secrets use VITE_ vars.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
